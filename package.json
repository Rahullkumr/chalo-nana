  },
  "keywords": [
    "ollama",
    "gemma",
    "openstreetmap",
    "local-ai",
    "elderly",
    "walking",
    "hindi",
    "hacktoberfest"
  ],
  "author": "Rahul Kumar",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
