{
  "name": "chalo-nana",
  "version": "1.0.0",
  "description": "A gentle daily walk sized for one grandparent: OpenStreetMap loop planned on the laptop, spoken in Hindi by a local Gemma model.",
  "main": "src/server.js",
  "scripts": {
