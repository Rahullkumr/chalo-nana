# This file is an example; put real values in .env, which git ignores.

# ElevenLabs voice that reads the plan aloud.
# Without a key, the page falls back to a voice installed on the device.
ELEVENLABS_API_KEY=
# Pick a voice your elder likes (Voice Library: Hindi, Indian accent), add it to My Voices, paste its ID.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# 0.0.0.0 lets a phone on the same Wi-Fi open the page. Default is this computer only.
# HOST=127.0.0.1
# PORT=3000

# Local model settings (defaults shown).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_KEEP_ALIVE=30m

# Where private data lives (map cache, places, profile, walk log). Default: data/
# DATA_DIR=data
